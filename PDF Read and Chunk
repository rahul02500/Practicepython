        "        contextual_chunks.append(Document(page_content=context+'\\n'+chunk.page_content,\n",
        "                                          metadata=chunk.metadata))\n",
        "    print('Finished processing:', file_path)\n",
        "    print()\n",
        "    return contextual_chunks"
