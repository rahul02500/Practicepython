        "      content = match.group(1).strip()\n",
        "      try:\n",
        "        return json.loads(content)\n",
        "      except json.JSONDecodeError:\n",
        "        raise ValueError(\"Content inside <tool_call> is not valid JSON.\")\n",
        "    else:\n",
        "        raise ValueError(\"No <tool_call> tags found in the text.\")"
